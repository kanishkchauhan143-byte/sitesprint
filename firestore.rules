rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Inquiries collection: Allow public creation of project inquiry leads
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.businessName is string
                    && request.resource.data.email is string
                    && request.resource.data.businessType is string
                    && request.resource.data.projectType is string
                    && request.resource.data.createdAt != null;
      allow read, update, delete: if false; // Protect client privacy; view leads in Firebase Console or via Admin SDK
    }
  }
}
